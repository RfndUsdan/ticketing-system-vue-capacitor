NODE_ENV=development
PORT=8000

DATABASE_URL=postgresql://apakabar:apakabar_dev_password@localhost:5432/apakabar?schema=public

JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Pisahkan dengan koma. Origin web + origin Capacitor Android.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost

# Dipakai untuk membentuk URL absolut file upload (image_url, avatar).
PUBLIC_BASE_URL=http://localhost:8000

AVATAR_MAX_UPLOAD_MB=2
TICKET_IMAGE_MAX_UPLOAD_MB=10

# Dipakai untuk membentuk tautan reset password di email.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# Opsional: webhook email. Jika kosong, mode development menampilkan tautan di respons API.
# Payload: { "to", "subject", "text", "html" }, dengan Bearer token jika diisi.
# PASSWORD_RESET_EMAIL_URL=https://api.emailprovider.com/send
# PASSWORD_RESET_EMAIL_TOKEN=ganti-dengan-api-key-email
