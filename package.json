{
  "name": "fe-dummy-studentticket",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:api": "npm run dev --workspace @apakabar/api",
    "api:build": "npm run build --workspace @apakabar/api",
    "api:typecheck": "npm run typecheck --workspace @apakabar/api",
    "api:generate": "npm run prisma:generate --workspace @apakabar/api",
    "api:deploy": "npm run prisma:deploy --workspace @apakabar/api",
    "api:migrate": "npm run prisma:migrate --workspace @apakabar/api --",
    "api:seed": "npm run db:seed --workspace @apakabar/api",
    "api:test": "npm run test --workspace @apakabar/api",
    "api:test:integration": "npm run test:integration --workspace @apakabar/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "cropperjs": "^1.6.2",
    "feather-icons": "^4.29.2",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^29.1.1",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.12"
  }
